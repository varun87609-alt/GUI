# ==============================================================================
# OpenFOAM Meshing Web Application Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local adjustments. DO NOT commit actual secrets.

# Server settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Docker & OpenFOAM Configuration
DOCKER_IMAGE=openeuler/openfoam:2506-oe2403sp4
OPENFOAM_INSTALL_DIR=/opt/OpenFOAM-v2506

# Job Storage & Workspace
WORKSPACE_DIR=workspace_jobs
DATABASE_URL=sqlite:///workspace_jobs/jobs.db

# Resource & Execution Limits
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_TRIANGLE_COUNT=1000000
MAX_ESTIMATED_CELLS=3000000
DEFAULT_JOB_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=2

# Container Limits
CONTAINER_CPU_LIMIT=2.0
CONTAINER_MEM_LIMIT=4g

# Security & CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
